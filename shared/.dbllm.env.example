# .dbllm.env — db-llm 配置文件
#
# 首次使用：本文件由 /pg-readonly-setup 自动复制为 .dbmeta/.dbllm.env，
# 填入真实值后即可使用。
#
# .dbmeta/.dbllm.env 已在 .gitignore 中，不会被提交。
# 本 .example 文件是 git-tracked 的，供团队成员参考格式。
#
# 解析规则：逐行 KEY=VALUE（不 source），未知 key 被忽略。
# 不要加 export 前缀、引号或前导空格。

# 采集范围：逗号分隔的 schema 名。留空 = 全库非系统 schema。
SCHEMAS=

# PostgreSQL 连接信息
# DB_HOST / DB_PORT 只在**直连模式**必填。走隧道时（下方 SSH_HOST 填了真值）
# 这两个值由隧道完全确定——引擎取 localhost 与 SSH_LOCAL_PORT，本文件里填的值
# 不被读取。既有配置留着它们无妨（不报错），新配置走隧道时可整行删掉。
DB_HOST=CHANGE_ME
DB_PORT=5432
DB_NAME=CHANGE_ME

# 只读角色名（默认 llm_readonly）。
# /pg-readonly-setup 用此名称生成 CREATE ROLE SQL。
DB_USER=llm_readonly

# 只读角色密码。首次留 CHANGE_ME，/pg-readonly-setup 会自动生成随机密码写回。
DB_PASSWORD=CHANGE_ME

# 只读查询默认行数上限（可选，默认 200）
# RO_DEFAULT_LIMIT=200

# SSH 隧道（可选，不用隧道就保持注释）
# 填好 SSH_HOST 等字段即可——/pg-dict、/pg-query-ro 等采集命令会在连接前自动确保隧道已起
# （已监听则复用，未监听则自动启动并等待就绪），不再需要手动先跑 shared/ssh-tunnel.sh start。
# 仍可手动 `bash shared/ssh-tunnel.sh start/stop/status` 管理隧道生命周期（不自动关）。
#
# 隧道模式硬约束（自动校验，不满足会 fail-loud 报三要素）：
#   - SSH_LOCAL_PORT / SSH_PORT / SSH_REMOTE_PORT 必须是 1..65535 的整数
#   - 认证二选一：SSH_KEY_FILE（证书，优先）或 SSH_PASSWORD（密码，需本机安装 sshpass）
#   - SSH_KEY_FILE 路径只支持 ~/ 前缀（按字面替换为 $HOME），不支持 $VAR 与通配符——
#     本文件被逐行解析、从不 source（ADR-0006）。写 $HOME/... 会当字面量拿去找文件
#
# 字段顺序 = 数据流向：本地端 -> 跳板 -> 远端 -> 认证
#   localhost:SSH_LOCAL_PORT --> SSH_USER@SSH_HOST:SSH_PORT --> SSH_REMOTE_HOST:SSH_REMOTE_PORT
# （与 tests/.env.test.example 的 SSH 段顺序一致，两处照着填不用来回对）
#
# SSH_LOCAL_PORT=15432
# SSH_HOST=
# SSH_PORT=22
# SSH_USER=
# SSH_REMOTE_HOST=
# SSH_REMOTE_PORT=5432
# SSH_KEY_FILE=~/.ssh/id_rsa
# SSH_PASSWORD=
#
# 从旧版（本地已手动开着隧道）升级：无需改动，把上面的 SSH_* 字段照实填好即可——
# ensure 判到端口已监听会直接复用，不会重复启动。
